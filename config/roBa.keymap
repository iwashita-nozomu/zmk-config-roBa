#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// JIS host layout: keep symbol positions, translate only the HID usage/modifier.
// Shift uses native JIS pairs, e.g. JP_AT_SIGN (@) -> ` and SEMICOLON -> +.
#define JP_SQT                  LS(NUMBER_7)
#define JP_DOUBLE_QUOTES        LS(NUMBER_2)
#define JP_COLON                SQT
#define JP_EQUAL                LS(MINUS)
#define JP_PLUS                 LS(SEMICOLON)
#define JP_ASTERISK             LS(SQT)
#define JP_CARET                EQUAL
#define JP_AMPERSAND            LS(NUMBER_6)
#define JP_TILDE                LS(EQUAL)
#define JP_AT_SIGN              LEFT_BRACKET
#define JP_LEFT_PARENTHESIS     LS(NUMBER_8)
#define JP_RIGHT_PARENTHESIS    LS(NUMBER_9)
#define JP_LEFT_BRACKET         RIGHT_BRACKET
#define JP_RIGHT_BRACKET        NON_US_HASH
#define JP_LEFT_BRACE           LS(RIGHT_BRACKET)
#define JP_RIGHT_BRACE          LS(NON_US_HASH)
#define JP_UNDERSCORE           LS(INT_RO)
#define JP_BACKSLASH            INT_RO
#define JP_PIPE                 LS(INT_YEN)

// Keep these numbers in the same order as the layer nodes below.
// Manual layers override automouse; SCROLL must be the highest pointing layer.
#define L_BASE    0
#define L_IME_ALT 1
#define L_MOUSE   2
#define L_SLOW    3
#define L_NUM     4
#define L_NAV     5
#define L_FN      6
#define L_SCROLL  7
#define L_SYSTEM  8

// Held SCROLL/SLOW must retain clicks, N (scroll), and the key below P (slow) after MOUSE expires.
#define POINTING_BINDINGS \
    &trans  &trans  &trans  &trans  &trans  &kp LC(C)  &mkp MB1  &mkp MB3  &mkp MB2  &kp LC(V) \
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo L_SLOW \
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mo L_SCROLL  &trans  &trans  &trans  &trans \
    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <L_MOUSE>;
    scroll-layers = <L_SCROLL>;
};

// This listener is enabled only on the pointing (right) half by its overlay.
// Apply both scalers whenever SLOW is active, including beneath SCROLL.
&trackball_listener {
    slow {
        layers = <L_SLOW>;
        input-processors = <&zip_xy_scaler 1 4>, <&zip_scroll_scaler 1 4>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <L_BASE L_IME_ALT L_MOUSE L_SLOW>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <L_BASE L_IME_ALT L_MOUSE L_SLOW>;
        };

        exit_mouse {
            bindings = <&mouse_off L_MOUSE>;
            key-positions = <11 10>;
            layers = <L_BASE L_IME_ALT L_MOUSE L_SLOW>;
        };

        double_quotation {
            bindings = <&kp JP_DOUBLE_QUOTES>;
            key-positions = <20 21>;
            // Position 21 is SLOW during pointing; do not capture that hold.
            layers = <L_BASE L_IME_ALT>;
        };

        eq {
            bindings = <&kp JP_EQUAL>;
            key-positions = <24 25>;
            layers = <L_BASE L_IME_ALT L_MOUSE L_SLOW>;
        };
    };

    behaviors {
        // A chord selects Shift; only a standalone tap changes IME/MOUSE state.
        ime_shift: ime_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&ime_toggle>;
        };

        mouse_off: mouse_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    macros {
        // Flip only the local send-order bit, not the host IME state.
        ime_toggle: ime_toggle {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            bindings = <&macro_press &mouse_off L_MOUSE &tog L_IME_ALT
                        &macro_tap &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            // Left thumb: IME/Shift, Space/NUM, Tab/NAV.
            // Right thumb: Backspace and Enter/FUNCTION; bottom-right: Esc/SYSTEM.
            bindings = <
&kp Q             &kp W         &kp E         &kp R                   &kp T                                               &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                   &kp G        &kp LS(LG(S))    &kp MINUS  &kp H        &kp J  &kp K      &kp L    &kp JP_SQT
&kp Z            &kp X         &kp C         &kp V                   &kp B        &kp JP_COLON        &kp SEMICOLON       &lt L_SCROLL N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &ime_shift LEFT_SHIFT LANG1  &lt L_NUM SPACE  &lt L_NAV TAB  &kp BACKSPACE  &lt L_FN ENTER                     &lt L_SYSTEM ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        // One send-order bit: off -> LANG1, on -> LANG2. Starts off at boot.
        // All other keys/sensors inherit; keep this below every operation layer.
        IME_ALT {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &ime_shift LEFT_SHIFT LANG2  &trans  &trans      &trans  &trans                  &trans
            >;
        };

        MOUSE {
            bindings = <POINTING_BINDINGS>;
        };

        // Below manual layers: cannot turn a held SCROLL into pointer motion.
        SLOW {
            bindings = <POINTING_BINDINGS>;
        };

        NUM {
            // Number-row usages and JP_* symbols expect a JIS host layout.
            bindings = <
&kp MINUS                   &kp NUMBER_7     &kp NUMBER_8     &kp NUMBER_9     &kp JP_PLUS                                                     &kp JP_CARET         &kp JP_AMPERSAND      &kp JP_TILDE       &kp JP_LEFT_PARENTHESIS  &kp JP_RIGHT_PARENTHESIS
&kp SLASH                   &kp NUMBER_4     &kp NUMBER_5     &kp NUMBER_6     &kp JP_ASTERISK  &kp LC(LA(KP_NUMBER_0))    &kp JP_UNDERSCORE  &kp EXCLAMATION   &kp JP_AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT NUMBER_0      &kp NUMBER_1     &kp NUMBER_2     &kp NUMBER_3     &kp PERIOD    &kp JP_EQUAL                  &kp JP_PIPE        &kp JP_LEFT_BRACKET  &kp JP_RIGHT_BRACKET  &kp JP_LEFT_BRACE  &kp JP_RIGHT_BRACE       &kp JP_BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans                     &trans          &trans                                                                     &trans
            >;
        };

        NAV {
            // Unused Y/U/I/O/P positions block both letters and lower-layer actions.
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &trans  &kp LC(TAB)              &trans                                  &none           &none           &none         &none            &none
&kp HOME        &trans                  &trans  &trans                  &kp END  &trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp JP_SQT
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans  &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans        &trans          &trans          &trans        &trans           &trans
&trans          &trans                  &trans  &trans                  &trans   &trans      &trans        &trans                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                  &kp F1   &kp F2   &kp F3   &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F6   &kp F7   &kp F8   &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans        &kp F11  &kp F12  &kp F13  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp DEL       &trans                               &trans
            >;
        };

        SCROLL {
            bindings = <POINTING_BINDINGS>;
        };

        SYSTEM {
            bindings = <
&trans  &trans        &trans        &trans        &trans                             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans     &kp NUMBER_1        &kp NUMBER_2        &kp NUMBER_3        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader   &trans        &trans        &trans        &bt BT_CLR_ALL  &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans        &trans                                                        &trans
            >;
        };
    };
};
